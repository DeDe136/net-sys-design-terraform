# ──────────────────────────────────────────────────────────────────
# secret.tfvars.example — File mẫu, SAFE để commit lên Git
# Sao chép thành secret.tfvars rồi điền giá trị thật:
#   cp secret.tfvars.example secret.tfvars
#
# Chạy Terraform:
#   terraform plan  -var-file="secret.tfvars"
#   terraform apply -var-file="secret.tfvars"
# ──────────────────────────────────────────────────────────────────

# ══════════════════════════════════════════════════════════════════
# AWS Authentication — chọn 1 trong 4 phương thức bên dưới.
# Bỏ trống ("") các phương thức KHÔNG dùng.
# ══════════════════════════════════════════════════════════════════

# ── Phương thức 1: Named Profile (~/.aws/credentials) ─────────────
aws_profile = ""

# ── Phương thức 2: Access Key trực tiếp ───────────────────────────
# aws_profile    = ""
# aws_access_key = ""
# aws_secret_key = ""

# ── Phương thức 3: Assume IAM Role ────────────────────────────────
# aws_role_arn         = ""
# aws_role_external_id = ""

# ── Phương thức 4: Environment Variables ──────────────────────────
# Không cần khai báo gì ở đây. Đặt aws_profile = "" và chạy:
#   export AWS_ACCESS_KEY_ID="..."
#   export AWS_SECRET_ACCESS_KEY="..."
#   export AWS_DEFAULT_REGION="us-east-1"

# ══════════════════════════════════════════════════════════════════
# RDS
# ══════════════════════════════════════════════════════════════════
rds_password = ""

# ══════════════════════════════════════════════════════════════════
# Directory Service (Managed AD)
# ══════════════════════════════════════════════════════════════════
ds_directory_password = ""

# ══════════════════════════════════════════════════════════════════
# Client VPN — ACM Certificate ARNs
# ══════════════════════════════════════════════════════════════════
vpn_server_certificate_arn = ""
vpn_client_certificate_arn = ""
